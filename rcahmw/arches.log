ry': {'type': 'Point', 'coordinates': [-3.9398176, 52.181845]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('cb58308b-7a2a-4eab-886c-ecd83d136100')}], 'points': [{'point': {'lon': -3.9398176, 'lat': 52.181845}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529502.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'e3c99159-a032-47c9-b58a-ddbbc4010f80', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': "This site is difficult to interpret as it was the subject of an amateur excavation in the 1920s by Trevor Lewis, a Ceredigion antiquarian.  It now looks very much like a series of potato clamps or sunken shelters, with two parallel gullies (including NPRN 529662) running north to south across a levelled terrace.  These may however be features created by the excavation. Lewis seems to have uncovered evidence of a cottage or long hut here and his site plan shows that it was in the form of a central rectilinear structure, perhaps 10 metres by 4 metres, flanked by secondary structures appended to the north and south sides, all on an east-northeast to west-southwest axis. None of this is apparent at the site today.  Trevor Lewis's plan is reproduced as Figure 5, in his article ?Archaeological investigations in the vicinity of Llanddewi-Brefi and Llanfair-Clydogau?, which was published in Transactions of the Cardiganshire Antiquarian Society - Vol. 5 1927. R.P. Sambrook, Trysor, 28 March 2013", 'resourceinstanceid': 'e3c99159-a032-47c9-b58a-ddbbc4010f80', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popu