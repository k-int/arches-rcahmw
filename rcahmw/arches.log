onal': False}, {'label': 'No Preference', 'conceptid': UUID('bdf4c70c-6a13-4cd0-a33f-33241d81302e'), 'valueid': '078fdac7-cb0c-4ab6-b252-0db193d97a9c', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': '5df9cce7-961b-4330-9324-5740f749f658', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.8613623, 52.884622]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('9be4abe0-dd6b-4a06-b8c1-49761e3edfa0')}], 'points': [{'point': {'lon': -3.8613623, 'lat': 52.884622}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 530005.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'fe1fdf74-98a4-43fe-aa1b-89addcd546e6', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A rectangular sheep fold measuring approximately 17m by 7m, with three internal compartments and a section of revetment wall extending from its southwest end next to an entrance. The drystone walls of the structure survive to 0.9m in height and 0.75m in width. The overall structure is aligned northeast to southwest. An area of exposed bedrock within 10m of the structure may have been quarried for its construction. The southwest compartment of the sheep fold is roughly square, measuring 7m x 7m. An entrance is located along the southwest wall, obscured by wall collapse, and access to other compartments of the sheepfold is at the northern corner. There is a possible subdivision marked by a 2m long wall extending from the north-western wall at a distance of 3m from the northern corner of the compartment. The central compartment of the sheep fold measures approximately 8m x 8m. Openings to adjacent compartments are at both corners of the north-western wall. The northeast compartment of the sheepfold measures approximately 3.5 x 5m, and appears to be a later addition. Present on the 1889 25 inch OS map. T. Burke-Davies, ArcHeritage, 15 May 2012.', 'resourceinstanceid': 'fe1fdf74-98a4-43fe-aa1b-89addcd546e6', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Moel Oernant, Sheep Fold I', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '530006', 'tiles': [<TileModel: TileModel object (a2a4333e-a686-4008-8c88-701caa313b32)>, <TileModel: TileModel object (d4ffe6f4-7ffb-4cf1-a0db-d864f0fa12e8)>, <TileModel: TileModel object (f98a81a5-2a0d-4a46-909f-c1c5ccc8561f)>, <TileModel: TileModel object (1afc1566-45ea-4753-a449-a93350b31b13)>, <TileModel: TileModel object (618760dd-ed52-4181-8198-1dcbbf846557)>, <TileModel: TileModel object (490e11a3-b30e-4086-ac3a-510d2411bee6)>, <TileModel: TileModel object (32ef1297-ad0e-4c05-a394-883a5aaefada)>, <TileModel: TileModel object (658eb5ac-144f-4009-b8fb-dc8f258af269)>, <TileModel: TileModel object (81899ce8-1168-49db-9384-1d4f9efa4060)>, <TileModel: TileModel object (934ade0d-618f-4453-8192-10bac6269f4d)>, <TileModel: TileModel object (883479a5-d622-4d1f-90f5-9806c1829b93)>, <TileModel: TileModel object (485ab4ab-b0a1-407f-ba0f-1d46375cb5d7)>, <TileModel: TileModel object (cc9bc9ad-df1c-4955-9f1d-40042b1909f9)>, <TileModel: TileModel object (7041fe41-fab3-48f1-9338-7146d3240b5e)>, <TileModel: TileModel object (ab4c2e19-6fd9-46d5-a196-4bfbcb2bd769)>, <TileModel: TileModel object (3818608d-a7c6-4603-8f08-1c339adf61cd)>], 'strings': [{'string': 'Moel Oernant, Sheep Fold I', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'A rectangular sheep fold measuring approximately 17m by 7m, with three internal compartments and a section of revetment wall extending from its southwest end next to an entrance. The drystone walls of the structure survive to 0.9m in height and 0.75m in width. The overall structure is aligned northeast to southwest. An area of exposed bedrock within 10m of the structure may have been quarried for its construction. The southwest compartment of the sheep fold is roughly square, measuring 7m x 7m. An entrance is located along the southwest wall, obscured by wall collapse, and access to other compartments of the sheepfold is at the northern corner. There is a possible subdivision marked by a 2m long wall extending from the north-western wall at a distance of 3m from the northern corner of the compartment. The central compartment of the sheep fold measures approximately 8m x 8m. Openings to adjacent compartments are at both corners of the north-western wall. The northeast compartment of the sheepfold measures approximately 3.5 x 5m, and appears to be a later addition. Present on the 1889 25 inch OS map. T. Burke-Davies, ArcHeritage, 15 May 2012.', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SH7480033860', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SH7433', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SH73SW', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Grid reference taken at a central point within extensive site or complex', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'TBD', 'nodegroup_id': UUID('0b5446f8-a00c-11ea-a530-