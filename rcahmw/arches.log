a-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': '2112e92f-52eb-4bc4-a893-fc0b0b56a81e', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A building platform, terraced into an east-facing slope and measuring 9 metres long, east to west, by 6 metres wide.  The platform is strewn with jumbled stone, undoubtedly the remains of a building that stood here, but now so ruinous that no structure can be identified, other than a possible step down in floor level from west to east, which may indicate that it was a two-celled long hut.  A small shelter lies about 10 metres to the south-southwest, which must have been ancillary to this settlement site.  J.J. Hall, Trysor, 26 March 2013', 'resourceinstanceid': '2112e92f-52eb-4bc4-a893-fc0b0b56a81e', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Bryn Rhudd, Platform', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529477', 'tiles': [<TileModel: TileModel object (72a38730-b361-43db-83d2-ec7a9ab77759)>, <TileModel: TileModel object (d727c193-bcac-41dd-afb5-edb987224dbf)>, <TileModel: TileModel object (df9e190b-d775-4dde-82cd-7c2c1d4f834e)>, <TileModel: TileModel object (7602c890-3ccc-462d-880a-442f6fc9fb8c)>, <TileModel: TileModel object (1c5c030d-f086-4f4a-ac15-60267b69e14f)>, <TileModel: TileModel object (1019dd3c-d632-4a6e-aee0-e5bb18e000ae)>, <TileModel: TileModel object (4ad83727-91e8-412d-a582-dcc465d3cf84)>, <TileModel: TileModel object (6128df3f-96bf-44f5-b50d-f3a7737f7500)>, <TileModel: TileModel object (0f6fa1d6-d14f-4afa-bfbe-39ebb08b5029)>, <TileModel: TileModel object (73e8c38e-d3a3-4f94-a8e7-d5879079a4d4)>, <TileModel: TileModel object (0