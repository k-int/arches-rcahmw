ovisional': False}, {'label': 'Modern', 'conceptid': UUID('9269ac44-c042-49d1-9dbb-d24a164c89f2'), 'valueid': 'd1b20a5e-e15b-4987-90ca-629542012f59', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'Not Applicable', 'conceptid': UUID('d131c30a-ae2b-45a1-a9b8-c118e0ef1e32'), 'valueid': '54496ff2-4693-4138-ba03-277eff940f11', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'No Preference', 'conceptid': UUID('bdf4c70c-6a13-4cd0-a33f-33241d81302e'), 'valueid': '078fdac7-cb0c-4ab6-b252-0db193d97a9c', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': 'eb597868-a6a6-4a62-a1e1-2d2217da72a3', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.8545956, 52.861892]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('2c6a0ce6-1ccc-484d-b871-9614aa2620c8')}], 'points': [{'point': {'lon': -3.8545956, 'lat': 52.861892}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 530234.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'd18c177d-d786-4ccd-9161-d960b13aadd8', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A group of tunnels or sunken trenches covering an area approximately 45m by 50m, and associated with military training, probably dating to the First World War. The area can be roughly split into three sections, two comprising large areas of collapse and the third a section of tunnel collapse. The most southerly collapsed area is approximately 20m by 13m and 0.5m to 1m in depth. Sections of wooden plank, metal supports and a corrugated iron sheet are visible on the surface. Leading from this section is a hollow 8m in length and 0.5m in width, which abuts a visible selection of tunnel. The tunnel opening is approximately 0.5m in diameter, revealing 2m of the tunnel. Brick, iron, wooden crossbeams and corrugated metal sheeting is visible as part of its construction. To the north is another large area of collapse, connected from the tunnel opening by a linear hollow 15m long and 0.5m wide, probably a further collapsed section of tunnel or trench. The larger area is approximately 45m by 18m and 0.5m in depth. The group may represent linear trenches connecting roofed bunkers. A. Farrington-McCabe, ArcHeritage, 21 May 2012.', 'resourceinstanceid': 'd18c177d-d786-4ccd-9161-d960b13aadd8', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Mynydd Bach, Military Practice Trenches I', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '530235', 'tiles': [<TileModel: TileModel object (0acb2982-e8ff-4480-b595-31f8895d1d7b)>, <TileModel: TileModel object (dcbc1bca-b979-4044-9235-20702e517224)>, <TileModel: TileModel object (a988341b-8f1a-4f64-8ea7-e22d40a7ab2a)>, <TileModel: TileModel object (1f97ba30-60fd-4980-8b8a-b52c3dc9de63)>, <TileModel: TileModel object (afc3ed21-ddcd-4467-ab68-f91b4bbd4fc7)>, <TileModel: TileModel object (2198077d-9c40-4422-bfa6-ad82631c3220)>, <TileModel: TileModel object (21394a4c-d552-41de-994a-a4f0d4f83938)>, <TileModel: TileModel object (91c9583a-b0b8-41b2-b0f6-8cdfad3dcfe9)>, <TileModel: TileModel object (4c631570-de60-4919-aac6-d854c05c69f2)>, <TileModel: TileModel object (6b175fb3-7857-47a8-b819-bf4e5c6b72b0)>, <TileModel: TileModel object (17545dd2-57d2-4340-8eee-da8f58607521)>, <TileModel: TileModel object (ea3a32d8-f751-4da1-ae35-3d49ac8bac00)>, <TileModel: TileModel object (3393ca64-3204-4add-90ff-675eb2d759bb)>, <TileModel: TileModel object (3f24c16d-e56a-4773-81cf-720f22ab0400)>, <TileModel: TileModel object (50e54925-79ac-4607-ad5e-d0064023aed5)>, <TileModel: TileModel object (c77417c5-044b-4b4e-9fb2-49bcd5b62da1)>], 'strings': [{'string': 'Mynydd Bach, Military Practice Trenches I', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'A group of tunnels or sunken trenches covering an area approximately 45m by 50m, and associated with military training, probably dating to the First World War. The area can be roughly split into three sections, two comprising large areas of collapse and the third a section of tunnel collapse. The most southerly collapsed area is approximately 20m by 13m and 0.5m to 1m in depth. Sections of wooden plank, metal supports and a corrugated iron sheet are visible on the surface. Leading from this section is a hollow 8m in length and 0.5m in width, which abuts a visible selection of tunnel. The tunnel opening is approximately 0.5m in diameter, revealing 2m of the tunnel. Brick, iron, wooden crossbeams and corrugated metal sheeting is visible as part of its construction. To the north is another large area of collapse, connected from the tunnel opening by a linear hollow 15m long and 0.5m wide, probably a further collapsed section of tunnel or trench. The larger area is approximately 45m by 18m and 0.5m in depth. The group may represent linear trenches connecting roofed bunkers. A. Farrington-McCabe, ArcHeritage, 21 May 2012.', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SH7517030940', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SH7530', 'n