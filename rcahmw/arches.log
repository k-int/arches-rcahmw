s': [{'number': 529566.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'e7805126-5c75-40d8-95aa-626eb50dd9ac', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A narrow strip of ridge and furrow cultivation marks across the high, narrow ridge-top along the northern side of the Rhysgog valley.  They lie within the field parcel created by the earthwork bank NPRN 529699. The cultivation ridges are quite broad, measured at 1.5 metres from furrow to furrow, and may represent post-medieval farming associated with Rhysgog Uchaf farm, about 450 metres to the west-northwest.  However, late 19th century Ordnance Survey maps show that the field defined by bank NPRN 529699 was a conifer plantation and the ploughing here, and on the slopes to the southeast (NPRN 529565), may represent the preparation of the slopes prior to planting trees.  R.P.Sambrook, Trysor, 26 March 2013', 'resourceinstanceid': 'e7805126-5c75-40d8-95aa-626eb50dd9ac', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Cnwch, Cultivation Marks I', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529567', 'tiles': [<TileModel: TileModel object (2a10efe1-8215-4dee-ab98-933a03ee2cc4)>, <TileModel: TileModel object (81162c97-a1c1-4727-8af1-11b509bfbab8)>, <TileModel: TileModel object (d227b6f1-8ee6-47e4-9361-e3f0b900c5e3)>, <TileModel: TileModel object (bd2fde11-7767-4ab6-940d-a49c41feb467)>, <TileModel: TileModel object (45510670-0c4f-457c-8331-30b74919cd62)>, <TileModel: TileModel object (df17b1f0-2fc4-4595-886a-7e58a0bfed1c)>, <TileModel: TileModel object (1563071a-2c70-4ba3-8c68-6cf8275a2b55)>, <TileModel: TileModel object (33a1989f-6bbf-47fb-b3be-401e18b28398)>, <TileModel: TileModel object (fb16e5b8-41e3-4eb9-b995-f02e1a39453a)>, <TileModel: TileModel object (aaf9ac30-b81b-434a-adf3-4bfd2afaba5d)>, <TileModel: TileModel object (3ed58832-e677-42b1-811f-5d44d42bc221)>, <TileModel: TileModel object (8eaae304-61ac-4a33-b9d9-2c2577447b1e)>, <TileModel: TileModel object (27c06100-a536-46af-922f-8c7b4620e024)>, <TileModel: TileModel object (f9c4bbc6-4ceb-4919-80d6-59912be072a3)>, <TileModel: TileModel object (34177769-cd57-441c-bc68-e4e23545b8d5)>, <TileModel: TileModel object (8444251b-8756-4c16-a900-ad4dac53a31e)>], 'strings': [{'string': 'Cnwch, Cultivation Marks I', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'A narrow strip of ridge and furrow cultivation marks across the high, narrow ridge-top along the northern side of the Rhysgog valley.  They lie within the field parcel created by the earthwork bank NPRN 529699. The cultivation ridges are quite broad, measured at 1.5 metres from furrow to furrow, and may represent post-medieval farming associated with Rhysgog Uchaf farm, about 450 metres to the west-northwest.  However, late 19th century Ordnance Survey maps show that the field defined by bank NPRN 529699 was a conifer plantation and the ploughing here, and on the slopes to the southeast (NPRN 529565), may represent the preparation of the slopes prior to planting trees.  R.P.Sambrook, Trysor, 26 March 2013', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN6817554074', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SN6854', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisiona