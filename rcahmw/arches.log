-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'No preference', 'conceptid': '48d8d0a7-e708-4010-a13d-db47570d1fe7', 'valueid': '30307785-4739-466f-9941-f85256fc9919', 'nodegroup_id': '60120f4c-9ff2-11ea-a530-000d3a86d704', 'provisional': True}, {'label': 'Not Applicable', 'conceptid': 'd131c30a-ae2b-45a1-a9b8-c118e0ef1e32', 'valueid': '54496ff2-4693-4138-ba03-277eff940f11', 'nodegroup_id': '60120f5b-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Documents', 'conceptid': '4e33f31c-2767-4ebb-98ed-a68ed52cc168', 'valueid': '4356a4e8-73c9-46b6-8d56-46d351b3ffde', 'nodegroup_id': '60120f5b-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Not Applicable', 'conceptid': 'd131c30a-ae2b-45a1-a9b8-c118e0ef1e32', 'valueid': '54496ff2-4693-4138-ba03-277eff940f11', 'nodegroup_id': '60120f5b-9ff2-11ea-a530-000d3a86d704', 'provisional': True}, {'label': 'Complex', 'conceptid': '94c87648-73f8-4434-b205-0086bae1177a', 'valueid': '365e001f-8588-4aeb-8886-21f1753a7fd0', 'nodegroup_id': '60120f5b-9ff2-11ea-a530-000d3a86d704', 'provisional': True}, {'label': 'English Description', 'conceptid': 'e5817822-5334-47c9-85a6-f4cec157aac9', 'valueid': '7a82d020-e0f5-4459-b07f-d1e634547fa1', 'nodegroup_id': '60120f43-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'English Description', 'conceptid': 'e5817822-5334-47c9-85a6-f4cec157aac9', 'valueid': '7a82d020-e0f5-4459-b07f-d1e634547fa1', 'nodegroup_id': '60120f43-9ff2-11ea-a530-000d3a86d704', 'provisional': True}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': '7cacdc89-9df8-4610-b8b9-f0b250a90980', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.3513828, 52.566965]}, 'properties': {}}]}, 'nodegroup_id': '60120f6a-9ff2-11ea-a530-000d3a86d704', 'provisional': False, 'tileid': '999b8b05-89ca-415d-af34-b3f85cf8ffa1'}], 'points': [{'point': {'lon': -3.3513828, 'lat': 52.566965}, 'nodegroup_id': '60120f6a-9ff2-11ea-a530-000d3a86d704', 'pro