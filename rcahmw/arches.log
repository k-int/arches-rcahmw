528-f5a3-4d71-bf90-75f46ad7be6b', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.9265632, 52.167927]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('60c28f07-3e8f-49f5-8d33-41d2fb690ae0')}], 'points': [{'point': {'lon': -3.9265632, 'lat': 52.167927}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529568.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'd9a8e035-fc74-4b99-aff8-20f5a1848a6b', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'This is the former reservoir of the Rhysgog Lead Mine.  It was formed by raising a broad, curving, earthwork dam across the western side of a levelled area where there is a break in the ridge that separates the Rhysgog and Brefi valleys.  The leat (NPRN 529568) constructed to feed the mine runs through this pass, feeding the reservoir.  The resulting pond was triangular in shape and when full must have measured up to 60 metres northeast to southwest, by perhaps 55 metres wide.  The reservoir is now much reduced, with water usually only standing in its western half, behind the dam.  The dam still stands as a prominent feature. Some 60 metres long, up to 7 metres wide and over 2 metres high. It is not clear how water was transferred from here to the mine site some 150 metres downslope to the west-southwest.  R.P.Sambrook, Trysor, 26 March 2013', 'resourceinstanceid': 'd9a8e035-fc74-4b99-aff8-20f5a1848a6b', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Rhysgog Lead Mine, Reservoir', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529569', 'tiles': [<TileModel: TileModel object (893f5423-8eaa-419c-96b0-355a015575fd)>, <TileModel: TileModel object (20873b95-ddcf-426d-b971-5591469f00f0)>, <TileModel: TileModel object (d1b00629-243f-4c0b-aca0-e8788a36c7f1)>, <TileModel: TileModel object (bd96f0cd-5d38-4034-b1d5-023796dea281)>, <TileModel: TileModel object (923671e8-48bb-474a-a1fa-b72336c16937)>, <TileModel: TileModel object (b0a5623d-1336-4465-ada6-8a36d4a35e14)>, <TileModel: TileModel object (0af2a949-c173-4e05-85e2-dc94a6587b3e)>, <TileModel: TileModel object (c6911540-5d6e-416d-acc6-a9e651521788)>, <TileModel: TileModel object (bf997356-e56e-4d9d-b028-188fc97f0727)>, <TileModel: TileModel object (53777a3f-989d-482d-9b6e-0e47b5089149)>, <TileModel: TileModel object (18810a11-528b-48dc-b613-a9c7c3ba5487)>, <TileModel: TileModel object (871ea0e7-5c3a-4dc1-b122-c6fd4e0c2205)>, <TileModel: TileModel object (d96e92e7-9d5c-42af-bf32-7fbcc195a14c)>, <TileModel: TileModel object (b73b8f40-eb5f-4644-b157-8dc9da8a7300)>, <TileModel: TileModel object (511963bc-d331-497c-92c3-93bcb05ce66c)>, <TileModel: TileModel object (7087caa3-d180-4d88-b770-c5d47f5fdadc)>], 'strings': [{'string': 'Rhysgog Lead Mine, Reservoir', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'This is the former reservoir of the Rhysgog Lead Mine.  It was formed by raising a broad, curving, earthwork dam across the western side of a levelled area where there is a break in the ridge that separates the Rhysgog and Brefi valleys.  The leat (NPRN 529568) constructed to feed the mine runs through this pass, feeding the reservoir.  The resulting pond was triangular in shape and when full must have measured up to 60 metres northeast to southwest, by perhaps 55 metres wide.  The reservoir is now much reduced, with water usually only standing in its western half, behind the dam.  The dam still stands as a prominent feature. Some 60 metres long, up to 7 metres wide and over 2 metres high. It is not clear how water was transferred from here to the mine site some 150 metres downslope to the west-southwest.  R.P.Sambrook, Trysor, 26 March 2013', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN6824653900', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SN6853', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN65SE', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Grid reference taken at centre of site', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'RPS', 'nodegroup_id': UUID('0b5446f8-a00c-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Llanddewi Brefi', 'nodegroup_id': UUID('60120f3d-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Cardiganshire', 'nodegroup_id': UUID('60120f61-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Ceredigion', 'nodegroup_id': UUID('60120f46-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'RESERVOIR', 'nodegroup_id': UUID('60120f49-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No Preference', 'nodegroup_id': UUID('60120f49-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Not Applicable', 'nodegroup_id': UUID('60120f49-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': '11B', 'nodegroup_id': UUID('60120f55-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Not Applicable', 'nodegroup_id': UUID('60120f55-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Not Applicable',