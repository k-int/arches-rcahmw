33fcd'), 'valueid': '7e820b1d-61ed-4ac0-8e69-ae5ea7e6d39e', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'Possible Type', 'conceptid': UUID('87a03b9b-5305-4ba1-8f7d-a6c705c2369a'), 'valueid': '5dba2e8c-26c3-4ae9-9223-69dd2f3917b4', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'No Preference', 'conceptid': UUID('bdf4c70c-6a13-4cd0-a33f-33241d81302e'), 'valueid': '078fdac7-cb0c-4ab6-b252-0db193d97a9c', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': '14ce61fc-a65f-42c8-8c29-fdf1d90cf76d', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.9360065, 52.180316]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('fb17dd5f-2276-45e3-ad3f-e41ae80e9fd3')}], 'points': [{'point': {'lon': -3.9360065, 'lat': 52.180316}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529467.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': '26df6382-3d7e-4554-b6ab-ae0db3074fdb', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A ruined long hut, which stands on a platform terraced into the slope at its west-northwest end and upstanding at its east-southeast end.  The building measures approximately 7.2 metres long, west-northwest to east-southeast, by about 4 metres wide.  An entrance can be seen in the north-northeastern lateral wall. <br>\nInternally, at the east-southeast end, there are two short bays, about 2 metres long by 1 metre wide and separated by a short wall which is 0.60 metres thick.  These could have been cattle stalls.  At the same end of the hut, a narrow extension has been added, which is the same width as the main building, but only 0.75 metres long internally, with a 0.70 metre thick wall along it east-southeast side; its north-northeast end has been left open.  A semi-circular mound of stone outside the east-southeast end of the building may well represent a peat drying stand.<br>\nThere is also a rectilinear extension to the south-southwest lateral wall which measures 5 metres west-northwest to east-southeast, by 4 metres wide overall, 2 metres wide internally.  R.P. Sambrook, Trysor, 27 March 2013', 'resourceinstanceid': '26df6382-3d7e-4554-b6ab-ae0db3074fdb', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Cors y Clochydd, Long Hut II ', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529468', 'tiles': [<TileModel: TileModel object (a670949f-61f4-4b8e-9199-c47620b23b17)>, <TileModel: TileModel object (03d7b894-93ed-4c86-aa3f-3a709bf39138)>, <TileModel: TileModel object (9e8c760b-564f-4fee-881b-e848a2133e73)>, <TileModel: TileModel object (bb5a428b-58e7-4fd5-8b7b-8d09c549da80)>, <TileModel: TileModel object (a7f347e2-9179-4adb-a50f-2e88ef0e1910)>, <TileModel: TileModel object (96965194-e6ea-4e69-a071-9ade6e275ee5)>, <TileModel: TileModel object (eb03048d-c0a9-4fd3-ae67-6937cdcf0c4e)>, <TileModel: TileModel object (4464a687-25bb-473f-b102-c3ebe381b1a6)>, <TileModel: TileModel object (d386bc9b-518a-4da5-b3ad-eaef4a71bb6f)>, <TileModel: TileModel object (41b0d2ab-3205-4ece-845b-f1bcb61b8de1)>, <TileModel: TileModel object (4a1ddd54-e49e-4b3b-abe9-a7c144207e25)>, <TileModel: TileModel object (304a9a54-b3c9-4ccd-949f-9877b3a7ba82)>, <TileModel: TileModel object (b9483f2e-db27-4d5d-b667-c29773cab228)>, <TileModel: TileModel object (c466a258-afef-4185-87d6-900a7e648c15)>, <TileModel: TileModel object (a5537534-3c5f-432a-8bb8-81d482d82d81)>, <TileModel: TileModel object (77b0e9de-2724-43f0-9666-5144e9e0961f)>, <TileModel: TileModel object (5bf60623-a573-402c-8af8-b6f1c34131d9)>, <TileModel: TileModel object (7298143f-c25b-4107-a2ba-112e874445b6)>], 'strings': [{'string': 'Cors y Clochydd, Long Hut II ', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'A ruined long hut, which stands on a platform terraced into the slope at its west-northwest end and upstanding at its east-southeast end.  The building measures approximately 7.2 metres long, west-northwest to east-southeast, by about 4 metres wide.  An entrance can be seen in the north-northeastern lateral wall. <br>\nInternally, at the east-southeast end, there are two short bays, about 2 metres long by 1 metre wide and separated by a short wall which is 0.60 metres thick.  These could have been cattle stalls.  At the same end of the hut, a narrow extension has been added, which is the same width as the main building, but only 0.75 metres long internally, with a 0.70 metre thick wall along it east-southeast side; its north-northeast end has been left open.  A semi-circular mound of stone outside the east-southeast end of the building may well represent a peat drying stand.<br>\nThere is also a rectilinear extension to the south-southwest lateral wall which measures 5 metres west-northwest to east-southeast, by 4 metres wide overall, 2 metres wide internally.  R.P. Sambrook, Trysor, 27 March 2013', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN6770155440', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SN6755', 'nodegroup_id': U