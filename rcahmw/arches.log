: '5dba2e8c-26c3-4ae9-9223-69dd2f3917b4', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'No Preference', 'conceptid': UUID('bdf4c70c-6a13-4cd0-a33f-33241d81302e'), 'valueid': '078fdac7-cb0c-4ab6-b252-0db193d97a9c', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': '89a26a7b-b75d-4af8-8da4-cfe96df3419e', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.9336476, 52.181236]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('631cfdc5-e03c-40ca-ae3b-d8bb89433a49')}], 'points': [{'point': {'lon': -3.9336476, 'lat': 52.181236}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529512.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': '342e93f0-3273-477f-badb-e1dafca4a203', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': "Ceredigion antiquarian Trevor Lewis recorded a tradition in 1927 that a series of linear mounds on the slopes above Pont y Cyf, Cwm Brefi were known as ?Beddau'r Proffwydi? or the ?Prophet's Graves?.  He excavated one of the group of six mounds, but reported no findings of archaeological significance.  It seems that Lewis described a group of pillow mounds and when visited in 2012, one mound was identified here, which is undoubtedly a medieval or early post-medieval pillow mound.  The steep slope is now clad in thick bracken and there is also badger activity in the same area.  No certain evidence of the remaining 5 mounds described by Lewis could be detected.   J.J. Hall, Trysor, 26 March 2013", 'resourceinstanceid': '342e93f0-3273-477f-badb-e1dafca4a203', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Bedd y Proffwydi, Mounds', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529513', 'tiles': [<TileModel: TileModel object (c13091e0-ae84-4285-bcfc-c3269746d403)>, <TileModel: TileModel object (59b81ddf-20ad-40b6-9146-7263c7640c5f)>, <TileModel: TileModel object (b39e9393-1eb8-4496-bdc1-4d2769f00151)>, <TileModel: TileModel object (3cc30b61-3bc2-46ae-b740-c4d133c66910)>, <TileModel: TileModel object (d5fda4d3-b3c7-4156-bb07-3428647c173b)>, <TileModel: TileModel object (80cb6e2f-2ef3-4379-8633-2102849dc869)>, <TileModel: TileModel object (3c6be53d-3993-4f1c-b620-f256e8e10fa7)>, <TileModel: TileModel object (4f5f8699-e6a9-43d2-9417-016a920fd48d)>, <TileModel: TileModel object (32ad6418-712d-4c4e-aafd-a149147c5619)>, <TileModel: TileModel object (59df47ed-2a37-467a-a90d-ae787a51d8f5)>, <TileModel: TileModel object (f1f0a8aa-2901-4f4c-8de1-303a437f51ef)>, <TileModel: TileModel object (85c73e62-cc44-47dd-a3a9-c29546e5b9b6)>, <TileModel: TileModel object (892f010c-fcff-4327-ab92-016a69891fd0)>, <TileModel: TileModel object (4a9bb256-0288-4552-93d6-62ab90eb123e)>, <TileModel: TileModel object (bca674cb-924c-432d-a630-edec5ea3c383)>, <TileModel: TileModel object (a37add1b-763d-43f0-88c2-aaa7b6a3306e)>, <TileModel: TileModel object (0d95d844-5011-4222-af4e-71c1c135a2b3)>, <TileModel: TileModel object (78d84eab-6642-47af-a0fd-1d3acb4795bc)>], 'strings': [{'string': 'Bedd y Proffwydi, Mounds', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': "Ceredigion antiquarian Trevor Lewis recorded a tradition in 1927 that a series of linear mounds on the slopes above Pont y Cyf, Cwm Brefi were known as ?Beddau'r Proffwydi? or the ?Prophet's Graves?.  He excavated one of the group of six mounds, but reported no findings of archaeological significance.  It seems that Lewis described a group of pillow mounds and when visited in 2012, one mound was identified here, which is undoubtedly a medieval or early post-medieval pillow mound.  The steep slope is now clad in thick bracken and there is also badger activity in the same area.  No certain evidence of the remaining 5 mounds described by Lewis could be detected.   J.J. Hall, Trysor, 26 March 2013", 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN6822454626', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SN6854', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN65SE', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Grid reference taken at centre of site', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'JJH', 'nodegroup_id': UUID('0b5446f8-a00c-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Llanddewi Brefi', 'nodegroup_id': UUID('60120f3d-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Cardiganshire', 'nodegroup_id': UUID('60120f61-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Ceredigion', 'nodegroup_id': UUID('60120f46-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'PILLOW MOUND', 'nodegroup_id': UUID('60120f49-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No Preference', 'nodegroup_id': UUID('60120f49-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'Possible Type', 'nodegroup_id': UUID('60120f49-9ff2-11ea-a530-000d3a86d704'), 'provi