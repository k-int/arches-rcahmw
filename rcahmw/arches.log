lse}, {'label': 'PGW2', 'conceptid': 'f35ff680-dd19-4700-8f12-0b5224990705', 'valueid': '0f721afd-8452-4738-84ce-a952ef4e72e6', 'nodegroup_id': '60120f52-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Cadw', 'conceptid': 'ffeb8601-fb72-4b8e-9a07-29008f81214a', 'valueid': 'f6c80c3a-0352-4d89-8a00-ed6bb9fa7d2a', 'nodegroup_id': '60120f52-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Not Applicable', 'conceptid': 'd131c30a-ae2b-45a1-a9b8-c118e0ef1e32', 'valueid': '54496ff2-4693-4138-ba03-277eff940f11', 'nodegroup_id': '60120f5b-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Earthwork', 'conceptid': 'f2d530fa-5e40-4237-8885-bf635f02dd88', 'valueid': '54d7e6d4-4604-49ee-a027-021778082062', 'nodegroup_id': '60120f5b-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Post Medieval', 'conceptid': 'ee42790e-53a9-42b9-b3c5-672e8a933fcd', 'valueid': '7e820b1d-61ed-4ac0-8e69-ae5ea7e6d39e', 'nodegroup_id': '60120f58-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Not Applicable', 'conceptid': 'd131c30a-ae2b-45a1-a9b8-c118e0ef1e32', 'valueid': '54496ff2-4693-4138-ba03-277eff940f11', 'nodegroup_id': '60120f58-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'No Preference', 'conceptid': 'bdf4c70c-6a13-4cd0-a33f-33241d81302e', 'valueid': '078fdac7-cb0c-4ab6-b252-0db193d97a9c', 'nodegroup_id': '60120f58-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'Associated with', 'conceptid': '15b644ba-83f4-489d-919c-8a02baf2c04d', 'valueid': 'd0444dc5-bec8-4279-bdc6-3e5521e97ee9', 'nodegroup_id': '60120f5e-9ff2-11ea-a530-000d3a86d704', 'provisional': False}, {'label': 'No preference', 'conceptid': '48d8d0a7-e708-4010-a13d-db47570d1fe7', 'valueid': '30307785-4739-466f-9941-f85256fc9919', 'nodegroup_id': '60120f4c-9ff2-11ea-a530-000d3a86d704', 'provisional': True}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': '96c33644-27bd-4ea2-855d-ac0267d830fd', 'type': 