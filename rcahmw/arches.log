[{'number': 529494.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'd60275ee-e0e5-40e9-9883-9715e02d0c43', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A ruined long hut, which measures 6 metres in length, north to south, by 4 metres wide. It is terraced into a gentle slope at its northern end and a positive platform is evident beneath its western end. Within the southeastern corner of the hut is an unusual, but well-built circular structure, about 1 metre in diameter and set low on the ground surface. There is no reason to think that this feature is not contemporary with the occupation of the long hut.  R.P. Sambrook, Trysor, 27 March 2013', 'resourceinstanceid': 'd60275ee-e0e5-40e9-9883-9715e02d0c43', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Cae Penygraig, Bryn Poeth, Long Hut', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529495', 'tiles': [<TileModel: TileModel object (ad920087-9113-44ee-9600-ab183048b2fe)>, <TileModel: TileModel object (d41145dd-010f-4a7c-8f00-5f7fce044cc1)>, <TileModel: TileModel object (f4422e70-7c69-4cba-a2ee-00da41088858)>, <TileModel: TileModel object (57485d0b-cf4d-40fa-87be-f5e7256ba477)>, <TileModel: TileModel object (768a9fb1-1f8f-4c78-a5bf-d578b846e448)>, <TileModel: TileModel object (9b36db25-5ed6-455b-ac04-bfc82b0d1c59)>, <TileModel: TileModel object (d7f5fad0-0f00-451b-af3a-9ab7386c940a)>, <TileModel: TileModel object (6f5dec1b-b82b-48a6-8dcb-c5c9f1b2d789)>, <TileModel: TileModel object (e46486ad-b7af-4559-a28b-7eb50d3171e2)>, <TileModel: TileModel object (37f35f27-e507-4cce-b02a-90b0fef835ca)>, <T