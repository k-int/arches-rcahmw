'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'fd603bd0-197e-4c30-8ee8-52393d987d50', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'A narrow strip of ridge and furrow cultivation marks across the high, narrow ridge-top along the northern side of the Rhysgog valley.  They lie within the field parcel created by the earthwork bank NPRN 529699. The cultivation ridges are quite broad, measured at 2 metres from furrow to furrow, and may represent post-medieval farming associated with Rhysgog Uchaf farm, a little over 200 metres to the west.  However, late 19th century Ordnance Survey maps show that the field defined by bank NPRN 529699 was a conifer plantation and the ploughing here, and on the slopes to the southeast (NPRN 529565), may represent the preparation of the slopes prior to planting trees.  R.P.Sambrook, Trysor, 26 March 2013', 'resourceinstanceid': 'fd603bd0-197e-4c30-8ee8-52393d987d50', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Cnwch, Cultivation Marks III', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529563', 'tiles': [<TileModel: TileModel object (093525ba-3eb5-46b6-9e68-a99abb4df459)>, <TileModel: TileModel object (b607bcef-a605-4005-9d6d-791a6d49321b)>, <TileModel: TileModel object (59077a3a-c750-4ff3-a5b7-3aceb5c67fd2)>, <TileModel: TileModel object (60d8566a-8386-4575-bb62-f60dd1dd80f0)>, <TileModel: TileModel object (50352311-dbf2-4c5c-b42c-bd8ea91e1f2d)>, <TileModel: TileModel object (fc316dc6-ca94-4d3c-be45-be9637fea9f9)>, <TileModel: TileModel object (1b8d7441-a4b5-4154-ae88-981dc967ec18)>, <TileModel: TileModel object (57ce24c7-246e-4d4b-b3da-1b5ff2c89990)>, <TileModel: TileModel object (73682ad9-5de9-4ae7-9485-85d09048f3ae)>, <TileModel: TileModel object (37695c72-4505-4500-b0a8-68169c9f3874)>, <TileModel: TileModel object (ace40517-0394-4de8-b55c-88f5fceac7b4)>, <TileModel: TileModel object (d0021386-dc3f-4cdf-9450-c1c69e694c5a)>, <TileModel: TileModel object (b39b89d2-7247-418d-8e58-dfc859a0dd7d)>, <TileModel: TileModel object (9259c4a7-3243-47f2-864a-1fe32b752909)>, <TileModel: TileModel object (dfd1ee69-8c83-4cfd-b564-3e60b20a8d25)>, <TileModel: TileModel object (b6a82330-651f-4f18-b2e7-39ded1b5331a)>], 'strings': [{'string': 'Cnwch, Cultivation Marks III', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'A narrow strip of ridge and furrow cultivation marks across the high, narrow ridge-top along the northern side of the Rhysgog valley.  They lie within the field parcel created by the earthwork bank NPRN 529699. The cultivation ridges are quite broad, measured at 2 metres from furrow to furrow, and may represent post-medieval farming associated with Rhysgog Uchaf farm, a little over 200 metres to the west.  However, late 19th century Ordnance Survey maps show that the field defined by bank NPRN 529699 was a conifer plantation and the ploughing here, and on the slopes to the southeast (NPRN 529565), may represent the preparation of the slopes prior to planting trees.  R.P.Sambrook, Trysor, 26 March 2013', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'English Description', 'nodegroup_id': UUID('60120f43-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN6802654180', 'nodegroup_id': UUID('60120f67-9ff2-11ea-a530-000d3a86d704')}, {'string': 'SN6854', 'nodegroup_id': UUID('688529e4-9ff5-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'SN65SE