 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529567.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': '59568085-a58c-4816-979c-1044d84a6c06', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'This disused mine leat was constructed to bring water to the Rhysgog Lead Mine and probably dates to the 19th century.  It is well preserved as it approaches the reservoir, where it is seen to be a 1 metre wide channel, with a 1 metre wide bank along its downslope side.  The course of the leat can be followed from the reservoir it fed (NPRN 529569), northeastwards through a narrow pass between the Rhysgog and Brefi valleys.  It then runs parallel with the line of the Brefi valley, heading generally eastwards until it disappears into the forestry plantations at the head of the valley.  According to mining historian G.W. Hall, the leat took water from Llyn Berwyn, which is 6.7 kilometres to the northeast of the reservoir. Its course is, however, now largely lost in the forest plantations of the area.  R.P.Sambrook, Trysor, 26 March 2013', 'resourceinstanceid': '59568085-a58c-4816-979c-1044d84a6c06', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Rhysgog Lead Mine, Leat', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529568', 'tiles': [<TileModel: TileModel object (d3a89bfc-a6c0-4b95-a0b9-a3dd09e0297e)>, <TileModel: TileModel object (be860274-8fce-4ea2-ab9d-92c4abb672f0)>, <TileModel: TileModel object (262e0dd1-8d03-4fe8-9f38-fb69020902d9)>, <TileModel: TileModel object (8c96f6ba-e8c6-400d-91c3-71