type': 'Point', 'coordinates': [-3.8578747, 52.224633]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('d1e37156-8f22-467c-9fe0-6823b3dbc10e')}], 'points': [{'point': {'lon': -3.8578747, 'lat': 52.224633}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529657.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': 'c9e61850-6943-4eb6-a692-3eee2088d05b', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': 'There is scant evidence on the surface for this building, which appears to have been a long hut, situated on a natural, southeast-facing terrace. Much of the site is under thick reed growth, and the stones of the original structure have been reused to construct a sheep shelter or bield across the long hut.  The only clearly visible evidence for the long hut is seen at its north-northwest end, where the turf-covered wall bases forming its gable end can be seen.  These are 0.70 metres wide and up to 0.20 0metres high.  The long hut would have measured approximately 3.5 metres wide and must have been at least 5 metres long.  R.P. Sambrook, Trysor, 27 March 2013', 'resourceinstanceid': 'c9e61850-6943-4eb6-a692-3eee2088d05b', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Nant Rhosyglo, Long Hut', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529658', 'tiles': [<TileModel: TileModel object (727fe3af-803a-4ede-b828-8264ce4de908)>, <TileModel: TileModel object (b5945de6-65f1-4e3a-872c-05c63c8410f0)>, <TileModel: TileModel objec