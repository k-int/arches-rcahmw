ionaledits': None}, {'tileid': 'beced3e9-72d6-4e99-810d-853527f47c87', 'resourceinstance_id': UUID('4c1b42c5-09c8-451b-8fcc-cb641f420024'), 'parenttile_id': None, 'data': {'60120f5e-9ff2-11ea-a530-000d3a86d704': [{'resourceId': '6351ab83-3d49-4653-8554-5c3e88dc7d91', 'ontologyProperty': '', 'resourceXresourceId': '15ce722e-faee-4131-a374-ed5b8c869ebf', 'inverseOntologyProperty': ''}], '60120f75-9ff2-11ea-a530-000d3a86d704': 'd0444dc5-bec8-4279-bdc6-3e5521e97ee9'}, 'nodegroup_id': UUID('60120f5e-9ff2-11ea-a530-000d3a86d704'), 'sortorder': 0, 'provisionaledits': None}, {'tileid': 'c72e46d3-2870-4f6a-8120-701ce47e7292', 'resourceinstance_id': UUID('4c1b42c5-09c8-451b-8fcc-cb641f420024'), 'parenttile_id': None, 'data': {'60120f5e-9ff2-11ea-a530-000d3a86d704': [{'resourceId': 'c24184d0-9287-42d7-85f5-90a6fdfa499d', 'ontologyProperty': '', 'resourceXresourceId': 'da249c29-e56e-4860-9c15-928aac683f3c', 'inverseOntologyProperty': ''}], '60120f75-9ff2-11ea-a530-000d3a86d704': '2bcb5e40-ebdc-46c9-b91a-a3ac457771d5'}, 'nodegroup_id': UUID('60120f5e-9ff2-11ea-a530-000d3a86d704'), 'sortorder': 0, 'provisionaledits': None}, {'tileid': 'cc5752d4-1013-4de3-a4a3-8eede1f4a2d0', 'resourceinstance_id': UUID('4c1b42c5-09c8-451b-8fcc-cb641f420024'), 'parenttile_id': None, 'data': {'60120f5e-9ff2-11ea-a530-000d3a86d704': [{'resourceId': '96ccd2b2-a0ea-453b-9475-966eaf74c447', 'ontologyProperty': '', 'resourceXresourceId': '46495503-13ff-45dd-b194-6131ce8e8a8c', 'inverseOntologyProperty': ''}], '60120f75-9ff2-11ea-a530-000d3a86d704': '2bcb5e40-ebdc-46c9-b91a-a3ac457771d5'}, 'nodegroup_id': UUID('60120f5e-9ff2-11ea-a530-000d3a86d704'), 'sortorder': 0, 'provisionaledits': None}, {'tileid': '1c88e5a4-287a-4541-9765-9ec9fa8e5be5', 'resourceinstance_id': UUID('4c1b42c5-09c8-451b-8fcc-cb641f420024'), 'parenttile_id': None, 'data': {'0b5446f8-a00c-11ea-a530-000d3a86d704': None, '5e5d39f4-a00c-11ea-a530-000d3a86d704': '1997-06-27', '83277d3a-a00c-11ea-a530-000d3a86d704': 'NG', 'a0788be0-a00c-11ea-