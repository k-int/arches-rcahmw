ba03-277eff940f11', 'nodegroup_id': UUID('60120f5b-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'Earthwork', 'conceptid': UUID('f2d530fa-5e40-4237-8885-bf635f02dd88'), 'valueid': '54d7e6d4-4604-49ee-a027-021778082062', 'nodegroup_id': UUID('60120f5b-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'Post Medieval', 'conceptid': UUID('ee42790e-53a9-42b9-b3c5-672e8a933fcd'), 'valueid': '7e820b1d-61ed-4ac0-8e69-ae5ea7e6d39e', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'Not Applicable', 'conceptid': UUID('d131c30a-ae2b-45a1-a9b8-c118e0ef1e32'), 'valueid': '54496ff2-4693-4138-ba03-277eff940f11', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'label': 'No Preference', 'conceptid': UUID('bdf4c70c-6a13-4cd0-a33f-33241d81302e'), 'valueid': '078fdac7-cb0c-4ab6-b252-0db193d97a9c', 'nodegroup_id': UUID('60120f58-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'geometries': [{'geom': {'type': 'FeatureCollection', 'features': [{'id': '0b7d5792-fc27-4c46-817a-e46e2e4ab341', 'type': 'Feature', 'geometry': {'type': 'Point', 'coordinates': [-3.934377, 52.190962]}, 'properties': {}}]}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False, 'tileid': UUID('e071fccd-0dff-4731-ba41-cd884a95fc08')}], 'points': [{'point': {'lon': -3.934377, 'lat': 52.190962}, 'nodegroup_id': UUID('60120f6a-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'numbers': [{'number': 529507.0, 'nodegroup_id': UUID('60120f4f-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}], 'date_ranges': [], 'ids': [], 'provisional_resource': 'false'}}}, {'index': {'_index': 'rcahmw_resources', '_type': '_doc', '_id': '2529386f-768a-4459-b2e5-4c966e674fcf', 'status': 404, 'error': {'type': 'index_not_found_exception', 'reason': 'no such index [rcahmw_resources]', 'index_uuid': '4UoPqYUbTbOhxxsTW-tO1Q', 'index': 'rcahmw_resources'}, 'data': {'displaydescription': "This unusual monument appears to be an example of a Neolithic chambered cairn, which is a rare site type in southwest and midwest Wales.  Cerrig Clochesti was first described by Ceredigion antiquarian Trevor Lewis in 1927, when he part excavated the site, although did not appreciate its unique characteristics in terms of Ceredigion's prehistoric monuments.  Today it survives as a complex of features, most important of which are two large slabs of stone which were the capstones that originally covered two separate underground cists.  Before Lewis recorded the site in 1927, these capstones had already been dragged off their chambers. <br>\n<br>\nThis record relates to the eastern cist. This seems to have been associated with the substantial amount of stone spread downslope, to the northeast of the cist.<br>\nThe stone spread is almost 1 metre thick and presumably the remains of a cairn that completed the monument when it was first constructed.  The whole monument measures about 8.5 metres long, northeast to southwest, and is widest at its northeastern end at 6 metres wide, narrowing to 3.5 metres wide at the southwestern end.<br>\n<br>\nThe cist is at the upper or southwestern end of the monument.  The site was noted by Paul Sambrook during the 1990s and recorded in the regional Sites and Monuments Record at that time.  It was noted then that the cists were lined with drystone revetment walls, although by 2012 denser vegetation across the site effectively obscures this detail.  The cist is now about 1 metre long by 0.7 metres wide and 0.5 metres deep.  Lewis, in 1927, recorded that the cists here were up to `four feet? deep.  <br>\n<br>\nThe capstone that once covered the cist is a massive slab of stone.  It measures a little over 3 metres long, north to south, by 2 metres wide and is at least 0.40 metres thick.   Interestingly, the slab is not earthfast, but has slid downslope to rest on the loose stones that formed the body of the associated cairn. There remains a gap between the bottom of the slab and most of the stones beneath it.  R.P. Sambrook, Trysor, 28 March 2013", 'resourceinstanceid': '2529386f-768a-4459-b2e5-4c966e674fcf', 'graph_id': '60120f3c-9ff2-11ea-a530-000d3a86d704', 'map_popup': 'No preference', 'displayname': 'Cerrig Clochesti, Chambered Cairn', 'root_ontology_class': 'http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing', 'legacyid': '529508', 'tiles': [<TileModel: TileModel object (acb98d45-4962-473f-8c52-bfb1f7554ba0)>, <TileModel: TileModel object (e3721d1e-6f77-4c13-bcc1-901627ff45dc)>, <TileModel: TileModel object (6560f46e-d44b-4763-a5e6-35a481306152)>, <TileModel: TileModel object (ba07a2d4-6c9b-49d9-97c2-a3be5066284c)>, <TileModel: TileModel object (02731ce5-1128-44dc-a968-394a6e3e3f5e)>, <TileModel: TileModel object (5f45f0b0-8056-474e-8d43-36def3b2621d)>, <TileModel: TileModel object (065a6fc0-91f1-4148-977a-15ec603aa244)>, <TileModel: TileModel object (6980f65c-ebb3-49a8-870c-536659e84fba)>, <TileModel: TileModel object (a2bf8bc8-00b3-4041-b257-413c5a619a30)>, <TileModel: TileModel object (67b42e00-f37e-408e-a0e2-e85d557d7c75)>, <TileModel: TileModel object (b3383e99-33ec-4d69-a1a6-f0e558d1a2b4)>, <TileModel: TileModel object (29199bc4-bf23-4ef1-8c32-f8a0247044ae)>, <TileModel: TileModel object (b8e68a2f-3513-4b02-9c70-6f7729bf651d)>, <TileModel: TileModel object (f628cc24-cfbd-45b2-8323-390919fed02b)>, <TileModel: TileModel object (f804739d-e0e0-4ab3-9b85-3b30a6cffca7)>, <TileModel: TileModel object (aeeebe05-0ec9-40c3-9cd1-d2b4d6e1949c)>, <TileModel: TileModel object (82131ea0-61d9-49c6-a060-18614998916f)>], 'strings': [{'string': 'Cerrig Clochesti, Chambered Cairn', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': 'No preference', 'nodegroup_id': UUID('60120f4c-9ff2-11ea-a530-000d3a86d704'), 'provisional': False}, {'string': "This unusual monument appears to be an example of a Neolithic chambered cairn, which is a rare site type in southwest and midwest Wales.  Cerrig Clochesti was first described by Ceredigion antiquarian Trevor Lewis in 1927, when he part excavated the site, although did not appreciate its unique characteristics in terms of Ceredigion's prehistoric monuments.  Today it survives as a complex of features, most important of which are two large slabs of stone which were the capstones that originally covered two separate underground cists.  Before Lewis recorded the site in 1927, these capstones had already been dragged off their chambers. <br>\n<br>\nThis record relates to the eastern cist. This seems to have been associated with the substantial amount of stone spread downslope, to the northeast of the cist.<br>\nThe stone spread is almost 1 metre thick and presumably the remains of a cairn that completed the monument when it was first constructed.  The whole monument measures about 8.5 metres long, northeast to southwest, and is widest at its northeastern end at 6 metres wide, narrowing to 3.5 metres wide at the southwestern end.<br>\n<br>\nThe cist is at the upper or southwestern end of the monument.  The site was noted by Paul Sambrook during the 1990s and recorded in the regional Sites and Monuments Record at that time.  It was noted then that the cists were lined with drystone revetment walls, although by 2012 denser vegetation across the site effectively obscures this detail.  The cist is now about 1 metre long by 0.7 metres wide and 0.5 metres deep.  Lewis, in 1927, recorded that the cists here were up to `four feet? deep.  <br>\n<br>\nThe capstone that once covered the cist is a massive slab of stone.  It measures a little over 3 metres long, north to south, by 2 metres wide and is at least 0.40 metres thick.   Interestingly, the slab is not earthfast, but has slid downslope to rest on the loose stones that formed the body of the associated cairn. There remains a gap between the bottom of the slab and most of the stones beneath it.  R.P. Sambrook, Trysor, 28 March 2013", 'nodegroup_